# --- Application ---
PROJECT_NAME="Trésorerie CEEAM"
APP_NAME="Trésorerie CEEAM"
VERSION="1.0.0"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
API_V1_PREFIX="/api/v1"

# --- Base de données ---
# SQLite en dev local (fichier local dans backend/)
DATABASE_URL="sqlite:///./tresorerie_ceeam.db"
# PostgreSQL sur serveur distant :
# DATABASE_URL="postgresql://user:password@localhost:5432/tresorerie_ceeam"

# --- Sécurité & Authentification JWT ---
SECRET_KEY="remplacer_par_une_cle_secrete_aleatoire_tres_longue"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (frontend React / Vite) ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000"

# --- Premier compte Administrateur / Trésorier (seed) ---
FIRST_SUPERUSER_EMAIL="tresorier@ceeam.org"
FIRST_SUPERUSER_PASSWORD="changer_ce_mot_de_passe"
FIRST_SUPERUSER_NOM="CEEAM"
FIRST_SUPERUSER_PRENOM="Trésorier"
DEFAULT_ADMIN_EMAIL="tresorier@ceeam.org"
DEFAULT_ADMIN_PASSWORD="changer_ce_mot_de_passe"
DEFAULT_ADMIN_NOM="CEEAM"
DEFAULT_ADMIN_PRENOM="Trésorier"
