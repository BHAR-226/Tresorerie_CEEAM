# --- Application ---
APP_NAME="CEEAM Trésorerie"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Base de données ---
# SQLite en dev (fichier local dans backend/)
DATABASE_URL=sqlite:///./ceeam.db
# Pour PostgreSQL plus tard :
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ceeam

# --- Sécurité JWT ---
# Générer une vraie clé avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-your-own-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (frontend) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# --- Admin par défaut (seed) ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NOM=Admin
DEFAULT_ADMIN_PRENOM=Admin